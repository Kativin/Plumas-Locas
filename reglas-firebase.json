{
  "rules": {
    ".read": false,
    ".write": false,
    "v1": {
      "$modo": {
        ".read": "$modo === 'p' || $modo === 'c'",
        ".indexOn": ["s"],
        "$id": {
          ".write": "($modo === 'p' || $modo === 'c') && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['n', 's', 'r', 't'])",
          "n": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12" },
          "s": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 99999999" },
          "r": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999" },
          "t": { ".validate": "newData.val() === now" },
          "$otro": { ".validate": false }
        }
      }
    }
  }
}
